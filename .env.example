# Copy to .env for local development. On Vercel, set these under
# Project → Settings → Environment Variables. See docs/self-hosting.md.

# --- Required: Supabase (database + sign-in) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with VITE_ (that would publish it to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Canonical address for links and the sitemap (defaults to the Vercel production domain).
VITE_SITE_URL=

# AI: Ask a question, smart search, natural voice. Any OpenAI-compatible API.
OPENAI_API_KEY=
# AI_MODEL=gpt-4.1-mini
# AI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Maps: map display (browser key, restrict to your domain) and address checks (server key).
VITE_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_API_KEY=

# Weekly event scraping into the admin review queue.
FIRECRAWL_API_KEY=

# "Text FOOD to…" number, once the SMS line exists.
VITE_SMS_NUMBER=
